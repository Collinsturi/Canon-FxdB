<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fxdb.ui.controller.ConnectionSetupController">
    <top>
        <HBox alignment="CENTER_LEFT">
            <BorderPane.margin>
                <Insets top="10" right="10" bottom="0" left="10"/>
            </BorderPane.margin>
            <Label text="Connect Source and Target" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="? Tour" onAction="#onShowTour"/>
        </HBox>
    </top>
    <center>
        <HBox spacing="16" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                <VBox spacing="10" style="-fx-background-color: #fafafa; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 14;">
                    <Label text="Source" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Connect via:" minWidth="90"/>
                        <ComboBox fx:id="sourceKind" promptText="Database or File" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>

                    <VBox fx:id="sourceDbBox" spacing="8">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Provider:" minWidth="90"/>
                            <ComboBox fx:id="sourceProvider" promptText="Provider" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>

                        <VBox fx:id="sourceServerBox" spacing="8">
                            <GridPane hgap="6" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90"/>
                                    <ColumnConstraints percentWidth="60"/>
                                    <ColumnConstraints minWidth="40"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>
                                <Label text="Host:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="sourceHost" promptText="localhost" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Port:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="sourcePort" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                <Label text="Database:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="sourceDatabase" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                            </GridPane>
                        </VBox>

                        <HBox fx:id="sourceSqliteBox" spacing="6" alignment="CENTER_LEFT">
                            <Label text="File:" minWidth="90"/>
                            <TextField fx:id="sourceSqlitePath" promptText="path to .sqlite file" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse..." onAction="#onBrowseSourceSqlite"/>
                        </HBox>

                        <CheckBox fx:id="sourceAdvancedUrl" text="Enter full JDBC URL manually"/>
                        <TextField fx:id="sourceJdbcUrl" promptText="jdbc:postgresql://host:5432/database" editable="false"/>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Username:" minWidth="90"/>
                            <TextField fx:id="sourceUsername" promptText="optional" HBox.hgrow="ALWAYS"/>
                            <Label text="Password:"/>
                            <PasswordField fx:id="sourcePassword" promptText="optional" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="sourceFileBox" spacing="6">
                        <HBox spacing="6">
                            <TextField fx:id="sourceFilePath" promptText="file path" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse..." onAction="#onBrowseSourceFile"/>
                        </HBox>
                        <ComboBox fx:id="sourceFormat" promptText="format"/>
                        <TextField fx:id="sourceDelimiter" promptText="CSV delimiter (default ,)"/>
                        <CheckBox fx:id="sourceHasHeader" text="Has header row" selected="true"/>
                        <TextField fx:id="sourceSheetName" promptText="Excel sheet name (blank = first sheet)"/>
                    </VBox>

                    <Button text="Test Connection" onAction="#onTestSource"/>
                    <Label fx:id="sourceStatus" wrapText="true"/>
                </VBox>
            </ScrollPane>

            <Label text="&#8594;" style="-fx-font-size: 28px; -fx-text-fill: #999999;"/>

            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" HBox.hgrow="ALWAYS">
                <VBox spacing="10" style="-fx-background-color: #fafafa; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 14;">
                    <Label text="Target" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Connect via:" minWidth="90"/>
                        <ComboBox fx:id="targetKind" promptText="Database or File" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>

                    <VBox fx:id="targetDbBox" spacing="8">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Provider:" minWidth="90"/>
                            <ComboBox fx:id="targetProvider" promptText="Provider" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>

                        <VBox fx:id="targetServerBox" spacing="8">
                            <GridPane hgap="6" vgap="8">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="90"/>
                                    <ColumnConstraints percentWidth="60"/>
                                    <ColumnConstraints minWidth="40"/>
                                    <ColumnConstraints percentWidth="25"/>
                                </columnConstraints>
                                <Label text="Host:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                                <TextField fx:id="targetHost" promptText="localhost" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                                <Label text="Port:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                                <TextField fx:id="targetPort" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                                <Label text="Database:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                                <TextField fx:id="targetDatabase" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"/>
                            </GridPane>
                        </VBox>

                        <HBox fx:id="targetSqliteBox" spacing="6" alignment="CENTER_LEFT">
                            <Label text="File:" minWidth="90"/>
                            <TextField fx:id="targetSqlitePath" promptText="path to .sqlite file" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse..." onAction="#onBrowseTargetSqlite"/>
                        </HBox>

                        <CheckBox fx:id="targetAdvancedUrl" text="Enter full JDBC URL manually"/>
                        <TextField fx:id="targetJdbcUrl" promptText="jdbc:postgresql://host:5432/database" editable="false"/>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Username:" minWidth="90"/>
                            <TextField fx:id="targetUsername" promptText="optional" HBox.hgrow="ALWAYS"/>
                            <Label text="Password:"/>
                            <PasswordField fx:id="targetPassword" promptText="optional" HBox.hgrow="ALWAYS"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="targetFileBox" spacing="6">
                        <HBox spacing="6">
                            <TextField fx:id="targetFilePath" promptText="file path" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse..." onAction="#onBrowseTargetFile"/>
                        </HBox>
                        <ComboBox fx:id="targetFormat" promptText="format"/>
                        <TextField fx:id="targetDelimiter" promptText="CSV delimiter (default ,)"/>
                        <CheckBox fx:id="targetHasHeader" text="Has header row" selected="true"/>
                        <TextField fx:id="targetSheetName" promptText="Excel sheet name (blank = first sheet)"/>
                    </VBox>

                    <Button text="Test Connection" onAction="#onTestTarget"/>
                    <Label fx:id="targetStatus" wrapText="true"/>
                </VBox>
            </ScrollPane>
        </HBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button fx:id="nextButton" text="Next" onAction="#onNext"/>
        </HBox>
    </bottom>
</BorderPane>
