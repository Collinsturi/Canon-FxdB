<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fxdb.ui.controller.ConnectionSetupController">
    <top>
        <HBox alignment="CENTER_LEFT">
            <BorderPane.margin>
                <Insets top="10" right="10" bottom="0" left="10"/>
            </BorderPane.margin>
            <Label text="Connect Source and Target" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="? Tour" onAction="#onShowTour"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;">
            <VBox spacing="10" alignment="TOP_CENTER">
                <padding>
                    <Insets top="10" right="10" bottom="10" left="10"/>
                </padding>

                <VBox spacing="6" maxWidth="640" style="-fx-background-color: #fafafa; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 12;">
                    <Label text="Source" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Connect via:" minWidth="80"/>
                        <ComboBox fx:id="sourceKind" promptText="Database or File" prefWidth="160"/>
                    </HBox>

                    <VBox fx:id="sourceDbBox" spacing="6">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Provider:" minWidth="80"/>
                            <ComboBox fx:id="sourceProvider" promptText="Provider" prefWidth="160"/>
                        </HBox>

                        <VBox fx:id="sourceServerBox" spacing="6">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Host:" minWidth="80"/>
                                <TextField fx:id="sourceHost" promptText="localhost" prefWidth="220"/>
                                <Label text="Port:"/>
                                <TextField fx:id="sourcePort" prefWidth="70"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Database:" minWidth="80"/>
                                <TextField fx:id="sourceDatabase" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <HBox fx:id="sourceSqliteBox" spacing="6" alignment="CENTER_LEFT">
                            <Label text="File:" minWidth="80"/>
                            <TextField fx:id="sourceSqlitePath" promptText="path to .sqlite file" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse..." onAction="#onBrowseSourceSqlite"/>
                        </HBox>

                        <VBox fx:id="sourceSqlServerBox" spacing="6">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Auth:" minWidth="80"/>
                                <ComboBox fx:id="sourceSqlServerAuth" prefWidth="260"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="sourceSqlServerEncrypt" text="Encrypt connection"/>
                                <CheckBox fx:id="sourceSqlServerTrustCert" text="Trust server certificate"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Other props:" minWidth="80"/>
                                <TextField fx:id="sourceSqlServerExtraProps" promptText="key=value;key2=value2" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <CheckBox fx:id="sourceAdvancedUrl" text="Enter full JDBC URL manually"/>
                        <TextField fx:id="sourceJdbcUrl" promptText="jdbc:postgresql://host:5432/database" editable="false"/>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Username:" minWidth="80"/>
                            <TextField fx:id="sourceUsername" promptText="optional" prefWidth="160"/>
                            <Label text="Password:"/>
                            <PasswordField fx:id="sourcePassword" promptText="optional" prefWidth="160"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="sourceFileBox" spacing="6">
                        <HBox spacing="6">
                            <TextField fx:id="sourceFilePath" promptText="file path" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse..." onAction="#onBrowseSourceFile"/>
                        </HBox>
                        <ComboBox fx:id="sourceFormat" promptText="format"/>
                        <TextField fx:id="sourceDelimiter" promptText="CSV delimiter (default ,)"/>
                        <CheckBox fx:id="sourceHasHeader" text="Has header row" selected="true"/>
                        <TextField fx:id="sourceSheetName" promptText="Excel sheet name (blank = first sheet)"/>
                    </VBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Test Connection" onAction="#onTestSource"/>
                        <Label fx:id="sourceStatus" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ScrollPane fx:id="sourceTableListScroll" fitToWidth="true" prefHeight="90" maxHeight="90"
                                visible="false" managed="false" style="-fx-background-color: transparent;">
                        <FlowPane fx:id="sourceTableList" hgap="6" vgap="6"/>
                    </ScrollPane>
                </VBox>

                <Label text="&#8595;" style="-fx-font-size: 20px; -fx-text-fill: #999999;"/>

                <VBox spacing="6" maxWidth="640" style="-fx-background-color: #fafafa; -fx-border-color: #cccccc; -fx-border-radius: 4; -fx-background-radius: 4; -fx-padding: 12;">
                    <Label text="Target" style="-fx-font-size: 15px; -fx-font-weight: bold;"/>

                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Connect via:" minWidth="80"/>
                        <ComboBox fx:id="targetKind" promptText="Database or File" prefWidth="160"/>
                    </HBox>

                    <VBox fx:id="targetDbBox" spacing="6">
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Provider:" minWidth="80"/>
                            <ComboBox fx:id="targetProvider" promptText="Provider" prefWidth="160"/>
                        </HBox>

                        <VBox fx:id="targetServerBox" spacing="6">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Host:" minWidth="80"/>
                                <TextField fx:id="targetHost" promptText="localhost" prefWidth="220"/>
                                <Label text="Port:"/>
                                <TextField fx:id="targetPort" prefWidth="70"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Database:" minWidth="80"/>
                                <TextField fx:id="targetDatabase" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <HBox fx:id="targetSqliteBox" spacing="6" alignment="CENTER_LEFT">
                            <Label text="File:" minWidth="80"/>
                            <TextField fx:id="targetSqlitePath" promptText="path to .sqlite file" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse..." onAction="#onBrowseTargetSqlite"/>
                        </HBox>

                        <VBox fx:id="targetSqlServerBox" spacing="6">
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Auth:" minWidth="80"/>
                                <ComboBox fx:id="targetSqlServerAuth" prefWidth="260"/>
                            </HBox>
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <CheckBox fx:id="targetSqlServerEncrypt" text="Encrypt connection"/>
                                <CheckBox fx:id="targetSqlServerTrustCert" text="Trust server certificate"/>
                            </HBox>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Other props:" minWidth="80"/>
                                <TextField fx:id="targetSqlServerExtraProps" promptText="key=value;key2=value2" HBox.hgrow="ALWAYS"/>
                            </HBox>
                        </VBox>

                        <CheckBox fx:id="targetAdvancedUrl" text="Enter full JDBC URL manually"/>
                        <TextField fx:id="targetJdbcUrl" promptText="jdbc:postgresql://host:5432/database" editable="false"/>

                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Label text="Username:" minWidth="80"/>
                            <TextField fx:id="targetUsername" promptText="optional" prefWidth="160"/>
                            <Label text="Password:"/>
                            <PasswordField fx:id="targetPassword" promptText="optional" prefWidth="160"/>
                        </HBox>
                    </VBox>

                    <VBox fx:id="targetFileBox" spacing="6">
                        <HBox spacing="6">
                            <TextField fx:id="targetFilePath" promptText="file path" HBox.hgrow="ALWAYS"/>
                            <Button text="Browse..." onAction="#onBrowseTargetFile"/>
                        </HBox>
                        <ComboBox fx:id="targetFormat" promptText="format"/>
                        <TextField fx:id="targetDelimiter" promptText="CSV delimiter (default ,)"/>
                        <CheckBox fx:id="targetHasHeader" text="Has header row" selected="true"/>
                        <TextField fx:id="targetSheetName" promptText="Excel sheet name (blank = first sheet)"/>
                    </VBox>

                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Button text="Test Connection" onAction="#onTestTarget"/>
                        <Button fx:id="targetCreateDatabaseButton" text="Create Database" onAction="#onCreateTargetDatabase"/>
                        <Label fx:id="targetStatus" wrapText="true" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <ScrollPane fx:id="targetTableListScroll" fitToWidth="true" prefHeight="90" maxHeight="90"
                                visible="false" managed="false" style="-fx-background-color: transparent;">
                        <FlowPane fx:id="targetTableList" hgap="6" vgap="6"/>
                    </ScrollPane>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button fx:id="nextButton" text="Next" onAction="#onNext"/>
        </HBox>
    </bottom>
</BorderPane>
