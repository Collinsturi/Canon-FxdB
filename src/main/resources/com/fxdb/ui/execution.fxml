<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fxdb.ui.controller.ExecutionController">
    <top>
        <VBox spacing="6">
            <padding>
                <Insets top="10" right="10" bottom="0" left="10"/>
            </padding>
            <Label text="Run the Migration" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="On row error:"/>
                <ComboBox fx:id="errorPolicyBox"/>
                <Button fx:id="startButton" text="Start" onAction="#onStart"/>
                <Button fx:id="cancelButton" text="Cancel" onAction="#onCancel" disable="true"/>
            </HBox>
            <ProgressBar fx:id="progressBar" progress="0" maxWidth="Infinity"/>
            <Label fx:id="messageLabel"/>
        </VBox>
    </top>
    <center>
        <VBox spacing="8">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <TableView fx:id="resultsTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="tableNameColumn" text="Table" prefWidth="160"/>
                    <TableColumn fx:id="rowsReadColumn" text="Read" prefWidth="80"/>
                    <TableColumn fx:id="rowsWrittenColumn" text="Written" prefWidth="80"/>
                    <TableColumn fx:id="rowsSkippedColumn" text="Skipped" prefWidth="80"/>
                    <TableColumn fx:id="statusColumn" text="Status" prefWidth="100"/>
                    <TableColumn fx:id="errorCountColumn" text="Errors" prefWidth="80"/>
                </columns>
            </TableView>
            <TextArea fx:id="logArea" editable="false" prefHeight="150"/>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button fx:id="backButton" text="Back" onAction="#onBack"/>
            <Button fx:id="summaryButton" text="View Summary" onAction="#onViewSummary" disable="true"/>
        </HBox>
    </bottom>
</BorderPane>
