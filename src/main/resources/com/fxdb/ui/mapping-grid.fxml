<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fxdb.ui.controller.MappingGridController">
    <top>
        <VBox spacing="6">
            <padding>
                <Insets top="10" right="10" bottom="0" left="10"/>
            </padding>
            <Label text="Step 3: Review and Adjust Column Mapping" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Button text="Re-run Auto-match" onAction="#onAutoMatch"/>
                <Button text="Save Profile..." onAction="#onSaveProfile"/>
                <Button text="Load Profile..." onAction="#onLoadProfile"/>
            </HBox>
        </VBox>
    </top>
    <center>
        <TabPane fx:id="tabPane">
            <BorderPane.margin>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </BorderPane.margin>
        </TabPane>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Back" onAction="#onBack"/>
            <Button fx:id="nextButton" text="Next" onAction="#onNext"/>
        </HBox>
    </bottom>
</BorderPane>
