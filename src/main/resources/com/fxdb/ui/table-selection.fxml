<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.fxdb.ui.controller.TableSelectionController">
    <top>
        <Label text="Choose Tables to Migrate" style="-fx-font-size: 18px; -fx-font-weight: bold;">
            <BorderPane.margin>
                <Insets top="10" right="10" bottom="0" left="10"/>
            </BorderPane.margin>
        </Label>
    </top>
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <TableView fx:id="tableList" editable="true" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="selectedColumn" text="Include" editable="true" prefWidth="70"/>
                    <TableColumn fx:id="sourceTableColumn" text="Source Table" prefWidth="260"/>
                    <TableColumn fx:id="targetTableColumn" text="Target Table" editable="true" prefWidth="260"/>
                </columns>
            </TableView>
            <Label fx:id="statusLabel" wrapText="true"/>
        </VBox>
    </center>
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
            <Button text="Back" onAction="#onBack"/>
            <Button fx:id="nextButton" text="Next" onAction="#onNext"/>
        </HBox>
    </bottom>
</BorderPane>
